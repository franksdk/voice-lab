{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voice-lab",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "ws": "./cloudflare/websocket.mjs" },
  "assets": { "directory": "./dist-cloudflare", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "VOICE_STATE", "class_name": "VoiceState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VoiceState"] }],
  "vars": { "VOICE_USERNAME": "admin", "DASHSCOPE_REGION": "cn-beijing", "DASHSCOPE_MODEL": "qwen-audio-3.0-realtime-flash" },
  "observability": { "enabled": true }
}
