# Fill only the provider you want to use. All credentials below are empty.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
DASHSCOPE_MODEL=qwen-audio-3.0-realtime-flash
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_KEY=
# Legacy setting: keep empty; the current UI has no experience-code input.
DEMO_ACCESS_CODE=
# Local microphone access works on localhost without HTTPS.
PUBLIC_ORIGIN=http://localhost:8080
# Leave empty in basic mode. Gateway mode requires a trusted auth proxy.
INTERNAL_GATEWAY_TOKEN=
AUTH_MODE=basic
VOICE_USERNAME=demo
# Required, at least 12 characters. Fill in .env only; never commit it.
VOICE_PASSWORD=
# Persistent private account data. This directory is ignored by Git.
DATA_DIR=./data
HOST=127.0.0.1
PORT=8080
